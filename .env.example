# Discord Bot のトークン
DISCORD_TOKEN=
# Discord アプリケーション ID
DISCORD_CLIENT_ID=
# 開発用サーバー ID（空の場合はグローバル登録）
DISCORD_DEV_GUILD_ID=
# ログレベル（省略時 info）
LOG_LEVEL=
# 本番は production（Docker / 付属の常駐設定例では自動設定）
NODE_ENV=
# VOICEVOX ENGINE の URL（省略時 http://127.0.0.1:50021）
VOICEVOX_URL=
# VOICEVOX のリクエストタイムアウト（ミリ秒、省略時 15000、GET は最大 5000）
VOICEVOX_TIMEOUT_MS=
# 既定の VOICEVOX スタイル ID（省略時 3）
DEFAULT_STYLE_ID=
# 読み上げ文字数上限（省略時 100、超過時は「以下略」を追加）
READ_MAX_LENGTH=
# 未再生キューの件数上限（省略時 20）
MAX_QUEUE_LENGTH=
# 読み上げ除外接頭辞（省略時 ;、空なら除外なし）
READ_SKIP_PREFIX=

# SQLite DB パス（省略時 data/kosuzu.db、親ディレクトリは自動作成）
DATABASE_PATH=

# 無人 VC から退出する猶予（ミリ秒、省略時 10000、0 も可）
AUTO_LEAVE_GRACE_MS=
