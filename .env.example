# Discord Bot のトークン
DISCORD_TOKEN=
# Discord アプリケーション ID
DISCORD_CLIENT_ID=
# 開発用サーバー ID（空の場合はグローバル登録）
DISCORD_DEV_GUILD_ID=
# ログレベル（省略時 info）
LOG_LEVEL=
# VOICEVOX ENGINE の URL（省略時 http://127.0.0.1:50021）
VOICEVOX_URL=
# VOICEVOX のリクエストタイムアウト（ミリ秒、省略時 15000、GET は最大 5000）
VOICEVOX_TIMEOUT_MS=
# 既定の VOICEVOX スタイル ID（省略時 3）
DEFAULT_STYLE_ID=
# 読み上げ文字数上限（省略時 100、超過時は「以下略」を追加）
READ_MAX_LENGTH=
# 未再生キューの件数上限（省略時 20）
MAX_QUEUE_LENGTH=
# 読み上げ除外接頭辞（省略時 ;、空なら除外なし）
READ_SKIP_PREFIX=
